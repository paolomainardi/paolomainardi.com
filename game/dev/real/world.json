  "voices": {
    "study-enter": {
      "text": "Hello\u2026? The lamp is still warm. Whoever lives here left a moment ago. Or maybe\u2026 they never really left.",
      "src": "voices/study-enter.mp3"
    },
    "study-window": {
      "text": "The sea, keeping its own hours. Something blinked out there\u2026 or I need more sleep.",
      "src": "voices/study-window.mp3"
    },
    "study-laptop": {
      "text": "Still awake, as if someone stepped away mid-sentence. Forty tabs open. Definitely an engineer.",
      "src": "voices/study-laptop.mp3"
    },
    "study-bookshelf": {
      "text": "Six books, six subjects. Either a very curious mind\u2026 or a very short attention span.",
      "src": "voices/study-bookshelf.mp3"
    },
    "study-pendant": {
      "text": "A lamp over the desk. Someone works late in here. On what, I wonder\u2026 and who pays the electricity bill.",
      "src": "voices/study-pendant.mp3"
    },
    "study-oil-lamp": {
      "text": "An oil lamp, recently trimmed. Someone still looks after it. Retro, or just suspicious of the grid?",
      "src": "voices/study-oil-lamp.mp3"
    },
    "study-door": {
      "text": "I can hear the sea through the door\u2026 and footsteps? No. Just my own. Probably.",
      "src": "voices/study-door.mp3"
    },
    "book-workstation": {
      "text": "Notes on building a workstation. Someone has strong feelings about keyboards.",
      "src": "voices/book-workstation.mp3"
    },
    "book-linux": {
      "text": "Linux. The most worn spine on the shelf. Read again and again\u2026 or recompiled.",
      "src": "voices/book-linux.mp3"
    },
    "book-ai": {
      "text": "AI and agents. The ink still looks wet. Did someone write this\u2026 or something?",
      "src": "voices/book-ai.mp3"
    },
    "book-docker": {
      "text": "Docker. Boxes, inside boxes, inside boxes. I'm almost afraid to open the last one.",
      "src": "voices/book-docker.mp3"
    },
    "book-security": {
      "text": "Security. It won't open at first\u2026 then it does. Not very secure, then.",
      "src": "voices/book-security.mp3"
    },
    "book-personal": {
      "text": "Personal. I really shouldn't\u2026 then again, I'm already in their house.",
      "src": "voices/book-personal.mp3"
    },
    "harbour-enter": {
      "text": "Salt air\u2026 and nobody around. Except a cat, sitting there like the mayor of this place. I'd better introduce myself.",
      "src": "voices/harbour-enter.mp3"
    },
    "harbour-noticeboard": {
      "text": "Notes pinned for whoever passes by. Was someone expecting me? I didn't even bring a gift.",
      "src": "voices/harbour-noticeboard.mp3"
    },
    "harbour-boat": {
      "text": "Two oars, still wet. Someone came back not long ago\u2026 and left me the rowing.",
      "src": "voices/harbour-boat.mp3"
    },
    "harbour-lighthouse": {
      "text": "Still keeping watch. Who climbs all those stairs every night? Someone with excellent knees.",
      "src": "voices/harbour-lighthouse.mp3"
    },
    "harbour-beacon": {
      "text": "There it goes again\u2026 one flash, then the dark. Either it's calling someone, or the bulb is dying.",
      "src": "voices/harbour-beacon.mp3"
    },
    "harbour-street-lamp": {
      "text": "The quay lamp. Someone lit it before nightfall\u2026 then vanished. Very considerate. Very suspicious.",
      "src": "voices/harbour-street-lamp.mp3"
    },
    "harbour-door-lantern": {
      "text": "A lantern by the door, so nobody comes home in the dark. Nobody being\u2026 whom, exactly?",
      "src": "voices/harbour-door-lantern.mp3"
    },
    "harbour-door": {
      "text": "Back to the study, and its warm lamp. Maybe they came back while I was snooping.",
      "src": "voices/harbour-door.mp3"
    },
    "harbour-path": {
      "text": "A path along the shore. It leads to the light. They always do.",
      "src": "voices/harbour-path.mp3"
    },
    "lighthouse-enter": {
      "text": "All those stairs\u2026 and the light, still turning. Somebody keeps it burning. And nobody kept a lift.",
      "src": "voices/lighthouse-enter.mp3"
    },
    "lighthouse-lens": {
      "text": "The great lens. It turns the dark into a signal. For whom, I wonder\u2026 ships? Me? The neighbours?",
      "src": "voices/lighthouse-lens.mp3"
    },
    "lighthouse-desk-lamp": {
      "text": "A small lamp for long nights. The chair is still pulled out. They left in a hurry\u2026 or they're very relaxed.",
      "src": "voices/lighthouse-desk-lamp.mp3"
    },
    "lighthouse-letter": {
      "text": "A folded letter, left where it would be found. Maybe it was meant for me. Maybe that's what everyone thinks.",
      "src": "voices/lighthouse-letter.mp3"
    },
    "lighthouse-logbook": {
      "text": "The keeper's logbook. Places, dates, faces\u2026 a whole life of travelling to talk. Keepers aren't usually this chatty.",
      "src": "voices/lighthouse-logbook.mp3"
    },
    "lighthouse-stairs": {
      "text": "Back down. Same stairs, fewer complaints. I have a feeling I'm not done here.",
      "src": "voices/lighthouse-stairs.mp3"
    },
    "map-enter": {
      "text": "So this is the whole island. Small\u2026 but full of things somebody left behind. Like a desk, but bigger.",
      "src": "voices/map-enter.mp3"
    },
    "map-house": {
      "text": "The stone house. Where the lamp was still warm.",
      "src": "voices/map-house.mp3"
    },
    "map-harbour": {
      "text": "The harbour. Notes for strangers, and a boat that just came back.",
      "src": "voices/map-harbour.mp3"
    },
    "map-lighthouse": {
      "text": "The lighthouse. Whoever lives here\u2026 I think they're up there. Waiting, maybe.",
      "src": "voices/map-lighthouse.mp3"
    },
    "common-cant": {
      "text": "I don't think that's meant for me. And I've done worse.",
      "src": "voices/common-cant.mp3"
    },
    "common-lamp-on": {
      "text": "Let there be light.",
      "src": "voices/common-lamp-on.mp3"
    },
    "common-lamp-off": {
      "text": "A little less light\u2026 and a little more mystery.",
      "src": "voices/common-lamp-off.mp3"
    },
    "common-too-far": {
      "text": "Too far away. My arms aren't that long.",
      "src": "voices/common-too-far.mp3"
    },
    "common-keep": {
      "text": "I'll keep this one. It might be a clue. Or just paper.",
      "src": "voices/common-keep.mp3"
    },
    "common-have-it": {
      "text": "I already have it. I'm curious, not greedy.",
      "src": "voices/common-have-it.mp3"
    },
    "common-pockets": {
      "text": "Pockets emptied. Travelling light again.",
      "src": "voices/common-pockets.mp3"
    },
    "common-night": {
      "text": "Night already\u2026 everything looks more mysterious now. And darker. Mostly darker.",
      "src": "voices/common-night.mp3"
    },
    "common-dusk": {
      "text": "The sun is going down. The island is waking up.",
      "src": "voices/common-dusk.mp3"
    },
    "pocket-map": {
      "text": "My map of the island. Folded wrong, like every map.",
      "src": "voices/pocket-map.mp3"
    },
    "common-already-map": {
      "text": "I'm already looking at it.",
      "src": "voices/common-already-map.mp3"
    },
    "harbour-cat": {
      "text": "The mayor of the harbour. Her collar says Rosa. Black tie, white shirt\u2026 always dressed for office.",
      "src": "voices/harbour-cat.mp3"
    },
    "harbour-cat-pet": {
      "text": "Pleased to meet you, Madam Mayor. The island is in good paws.",
      "src": "voices/harbour-cat-pet.mp3"
    },
    "harbour-cat-take": {
      "text": "Kidnap the mayor? I'd never get off this island.",
      "src": "voices/harbour-cat-take.mp3"
    },
    "rosa-reply-1": {
      "text": "Did\u2026 did the cat just talk?",
      "src": "voices/rosa-reply-1.mp3"
    },
    "rosa-reply-2": {
      "text": "I prefer 'exploring'.",
      "src": "voices/rosa-reply-2.mp3"
    },
    "rosa-reply-3": {
      "text": "That explains a lot. Not everything.",
      "src": "voices/rosa-reply-3.mp3"
    }
  },
  "pocket": [
    {
      "id": "map",
      "label": "Island map",
      "icon": "items/map.png",
      "to": "map",
      "look": "pocket-map"
    }
  ]
