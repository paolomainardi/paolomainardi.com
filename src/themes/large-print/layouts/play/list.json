{{- /* The adventure's content contract, serialized once so notes and titles are escaped. */ -}}
{{- $items := slice -}}
{{- range where site.RegularPages "Section" "in" (slice "posts" "links") -}}
    {{- if and (not .Draft) (not (.PublishDate.After now)) (or .ExpiryDate.IsZero (.ExpiryDate.After now)) -}}
        {{- $item := dict "id" (.Slug | default .File.ContentBaseName) "title" .Title "date" (.Date | time.Format "2006-01-02") "tags" (.Params.tags | default slice) -}}
        {{- if eq .Section "posts" -}}
            {{- $reader := .OutputFormats.Get "reader" -}}
            {{- $item = merge $item (dict "type" "post" "description" (.Description | default .Summary | plainify) "url" .RelPermalink "reader" $reader.RelPermalink) -}}
            {{- with .Params.series }}{{ $item = merge $item (dict "series" .) }}{{ end -}}
            {{- with .Params.series_part }}{{ $item = merge $item (dict "part" .) }}{{ end -}}
            {{- with .Params.featuredImage -}}
                {{- $cover := partial "book/asset.html" . -}}
                {{- $item = merge $item (dict "cover" $cover.url) -}}
            {{- end -}}
        {{- else -}}
            {{- $item = merge $item (dict "type" "link" "description" .Plain "link" .Params.link) -}}
        {{- end -}}
        {{- $items = $items | append $item -}}
    {{- end -}}
{{- end -}}
{{- dict "items" $items | jsonify -}}
